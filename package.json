{
  "name": "enterprise-ai-assistant",
  "version": "1.0.0",
  "description": "企业AI助手中控平台 - 完整的前后端项目",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm run dev:client\" \"pnpm run dev:server\"",
    "dev:client": "cd client && pnpm run dev",
    "dev:server": "cd server && pnpm run dev",
    "build": "cd client && pnpm run build",
    "start": "cd server && pnpm start",
    "install:all": "pnpm install",
    "db:init": "cd server && node src/database/init.js",
    "lint": "eslint . --ext .js,.vue",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "enterprise",
    "ai",
    "assistant",
    "vue",
    "express",
    "fullstack"
  ],
  "author": "MI",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}